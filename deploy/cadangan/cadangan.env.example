# Konfigurasi cadangan SIGAP (NF-04). Salin ke /etc/sigap/cadangan.env (root, mode 600) dan isi di server.
# JANGAN di-commit setelah diisi.

APP_DIR=/var/www/sigap
DB_NAME=sigap

# Kredensial MySQL khusus cadangan (SELECT, LOCK TABLES, SHOW VIEW, TRIGGER, EVENT pada DB_NAME; serta
# ALL pada sigap_uji_pulih.* untuk uji pemulihan), dalam format [client] user=/password=. Mode 600.
MYSQL_CNF=/etc/sigap/mysql-cadangan.cnf

# Repositori restic di LUAR VPS (contoh: penyimpanan objek S3 berlokasi Indonesia, atau SFTP ke server lain).
RESTIC_REPOSITORY=s3:https://contoh-penyedia.id/sigap-cadangan
# Sandi enkripsi repositori restic, satu baris, mode 600. Simpan salinannya di luar VPS (bukan bersama cadangan).
RESTIC_PASSWORD_FILE=/etc/sigap/restic.pass
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Lama penyimpanan: semua cadangan 35 hari terakhir (NF-04: minimal 30 hari).
SIMPAN_HARI=35
