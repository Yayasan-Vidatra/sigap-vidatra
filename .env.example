APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Kunci HMAC untuk menandatangani tantangan CAPTCHA ALTCHA. Isi dengan string acak panjang,
# mis. hasil `php -r "echo bin2hex(random_bytes(32));"`. Jangan memakai APP_KEY.
ALTCHA_HMAC_KEY=

# Kunci enkripsi isi lampiran WBS: 32 byte dalam base64, mis. hasil
# `php -r "echo base64_encode(random_bytes(32));"`. Wajib sebelum kanal WBS menerima lampiran.
LAMPIRAN_KUNCI_ENKRIPSI=

# Pemindaian virus dan penghapusan metadata lampiran: "alat" di VPS (ClamAV, ExifTool, FFmpeg),
# "lokal" di Windows/Laragon tanpa alat tersebut (tercatat "tidak dipindai").
LAMPIRAN_PEMINDAI=lokal
LAMPIRAN_PEMBERSIH_METADATA=lokal
# LAMPIRAN_CLAMSCAN=clamscan
# LAMPIRAN_EXIFTOOL=exiftool
# LAMPIRAN_FFMPEG=ffmpeg

# Pemantauan (deploy/pantau): surel pengelola TI penerima peringatan, dipisah koma.
SIGAP_SUREL_PENGELOLA_TI=

# Kata sandi akun uji @sigap.test untuk `php artisan db:seed --class=AkunUjiSeeder`.
# Hanya untuk environment local; biarkan kosong di server.
AKUN_UJI_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
